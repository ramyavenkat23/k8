pipeline {
    agent any
    stages {
        stage('Pull Code From GitHub') {
            steps {
                git 'https://github.com/ramyavenkat23/k8.git'
            }
        }

        stage('Build the Docker image') {
            steps {
                sh 'docker build -t myimage /var/lib/jenkins/workspace/k8'
                sh 'docker tag myimage ramya0395/myimage:latest'
                sh 'docker tag myimage ramya0395/myimage:${BUILD_NUMBER}'
            }
        }

        stage('Push the Docker image') {
            steps {
                sh 'docker image push --all-tags ramya0395/myimage'
            }
        }

        stage('Deploy on Kubernetes') {
            steps {
                sh 'kubectl apply -f /var/lib/jenkins/workspace/k8/pod.yaml'
                sh 'kubectl rollout restart deployment loadbalancer-pod'
            }
        }
    }
}
